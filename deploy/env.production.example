# EDUZIYO — ishlab chiqarish .env namunasi (serverda: cp deploy/env.production.example .env, so'ng to'ldiring).
# .env hech qachon GitHub'ga yuklanmaydi (.gitignore'da).
APP_NAME="EDUZIYO"
APP_ENV=production
# deploy.sh birinchi ishga tushishda avtomatik yaratadi
APP_KEY=
APP_DEBUG=false
APP_URL=https://educrm.elshod.date
APP_LOCALE=uz
APP_FALLBACK_LOCALE=uz
APP_TIMEZONE=Asia/Tashkent

# docker logs eduziyo_app
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Baza: mavjud MariaDB/MySQL konteyneri (DB_NETWORK tarmog'i orqali). Alohida baza va foydalanuvchi — ./deploy/db-create.sh
DB_CONNECTION=mysql
# bazaning Docker tarmog'idagi xizmat/konteyner nomi
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=eduziyo
DB_USERNAME=eduziyo
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=240
SESSION_SECURE_COOKIE=true
CACHE_STORE=file
QUEUE_CONNECTION=database

# Docker (docker-compose.yml o'qiydi)
# faqat shu serverning o'zidan (cloudflared uchun). Internetga ochilmaydi.
WEB_BIND=127.0.0.1
WEB_PORT=7005
# `docker network ls` dan bazaning tarmog'i
DB_NETWORK=stack_default

# Integratsiyalar (Telegram/SMS/OpenAI) — afzali: sAdmin > Integratsiyalar sahifasi (bazada shifrlanib saqlanadi).
# Faqat shu yerda bo'lsa ham ishlaydi:
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
